# Copy to .env for local development. Never commit a real .env.

PORT=3000
# SQLite file used when DATABASE_URL is unset.
SQLITE_PATH=./data/poker-group.db

# Hosted (Render): set DATABASE_URL to the Postgres internal connection string.
# DATABASE_URL=postgres://user:pass@host:5432/poker_group

SESSION_SECRET=change-me-to-a-long-random-string
TZ=America/Phoenix

# Used only when seeding the first admin account locally.
ADMIN_EMAIL=eric@example.com
# If unset (and SETUP_TOKEN is unset), seed generates a password and writes it to data/admin-credentials.txt
# ADMIN_PASSWORD=

# Hosted bootstrap: a long random value set ONLY in the host's environment settings.
# While no organizer account exists, /setup/<SETUP_TOKEN> lets the organizer choose a
# password once. It expires after SETUP_TOKEN_TTL_HOURS (default 168 = 7 days).
# SETUP_TOKEN=
# SETUP_TOKEN_TTL_HOURS=168

# Set to 1 to start in-process job timers (still log-only; no real email/SMS).
RUN_JOBS=0
BASE_URL=http://localhost:3000
# NODE_ENV=production enables Secure cookies and binds to 0.0.0.0.
