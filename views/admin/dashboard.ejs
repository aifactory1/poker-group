<%- include('../partials/header') %>
<section>
  <div class="card" id="game" tabindex="-1">
    <h2>Next game</h2>
    <% if (!game) { %>
      <p class="muted">No upcoming scheduled Monday.</p>
    <% } else { %>
      <p id="dash-game-summary">
        <strong>Game:</strong> <%= formatNiceDate(game.game_date) %><br />
        <strong>Time:</strong> <%= formatTime12(game.start_time) %>–<%= formatTime12(game.end_time) %>
        <% if (typeof venue !== 'undefined' && venue) { %>
          <br /><strong>Venue:</strong> <span id="dash-game-venue"><%= venue %></span>
        <% } %>
      </p>
      <% if (game.status === 'cancelled') { %>
        <p>
          <span class="status-pill cancelled">Cancelled</span>
          <% if (game.skip_reason) { %><span class="muted"> <%= game.skip_reason %></span><% } %>
        </p>
        <div class="cancel-game-box">
          <form method="post" action="/dashboard/reinstate" onsubmit="return confirm('Reinstate the game on <%= formatNiceDate(game.game_date) %>?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn-primary" id="reinstate-game-btn">Reinstate game</button>
          </form>
        </div>
      <% } else { %>
        <p>
          <% if (tally.meetsMinimum) { %>
            <span class="status-pill on">On track — <%= tally.yesPeople %> confirmed (need <%= tally.minimum %>)</span>
          <% } else { %>
            <span class="status-pill warn">Short so far — <%= tally.yesPeople %> confirmed (need <%= tally.minimum %>)</span>
          <% } %>
        </p>
        <div class="stat-row" aria-live="polite">
          <div class="stat yes"><div class="n"><%= tally.yesPeople %></div><div class="l">Yes (people, incl. guests)</div></div>
          <div class="stat no"><div class="n"><%= tally.no %></div><div class="l">No</div></div>
          <div class="stat maybe"><div class="n"><%= tally.maybe %></div><div class="l">Maybe</div></div>
          <div class="stat unanswered"><div class="n"><%= tally.unanswered %></div><div class="l">Unanswered</div></div>
        </div>
        <p class="muted">Auto-cancel is <%= settings.auto_cancel_enabled ? 'ON' : 'OFF' %> at <%= formatTime12(settings.cutoff_time) %>, minimum <%= settings.minimum_yes %>.</p>
        <div class="cancel-game-box">
          <form method="post" action="/dashboard/cancel" id="cancel-game-form" onsubmit="return confirm('Cancel the game on <%= formatNiceDate(game.game_date) %>? Players will be notified (logged only during testing).');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label class="field">Optional reason
              <input type="text" name="reason" maxlength="200" placeholder="e.g. Only two people can make it" aria-label="Optional cancellation reason" />
            </label>
            <div class="row-actions">
              <button type="submit" class="btn btn-danger" id="cancel-game-btn">Cancel this game</button>
            </div>
          </form>
        </div>
      <% } %>
      <h3 id="attendees" tabindex="-1">Attendees for this game</h3>
      <% var canOverride = game.status === 'scheduled' && actor && actor.canOverrideRsvp; %>
      <% if (canOverride) { %>
      <% } %>
      <div class="attendees-wrap">
        <table id="attendees-table">
          <thead>
            <tr>
              <th scope="col">Player</th>
              <th scope="col">RSVP</th>
              <th scope="col">Party size</th>
              <th scope="col">Message</th>
            </tr>
          </thead>
          <tbody>
            <% tally.rows.forEach(function (row) { %>
              <% var statusLabel = row.status === 'unanswered' ? '—' : row.status; %>
              <% var currentLabel = row.status === 'unanswered' ? 'no reply yet' : row.status; %>
              <tr>
                <td><%= row.player.name %></td>
                <td>
                  <% if (canOverride) { %>
                    <button
                      type="button"
                      class="rsvp-cell-btn is-<%= row.status %>"
                      data-player-id="<%= row.player.id %>"
                      data-player-name="<%= row.player.name %>"
                      data-status="<%= row.status === 'unanswered' ? '' : row.status %>"
                      data-party-size="<%= row.status === 'yes' && row.coming ? row.coming : 1 %>"
                      aria-haspopup="dialog"
                      aria-expanded="false"
                      aria-controls="rsvp-editor"
                      aria-label="Change RSVP for <%= row.player.name %>, currently <%= currentLabel %>"
                    ><%= statusLabel %></button>
                  <% } else { %>
                    <span class="rsvp-cell-text is-<%= row.status %>"><%= statusLabel %></span>
                  <% } %>
                </td>
                <td><%= row.status === 'yes' ? row.coming : '—' %></td>
                <td>
                  <% if (row.rsvp && row.rsvp.message) { %>
                    <span class="vis-tag"><%= row.rsvp.message_visibility === 'group' ? 'Group' : 'Organizer only' %></span>
                    <%= row.rsvp.message %>
                  <% } else { %>—<% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (canOverride) { %>
        <div id="rsvp-editor" class="rsvp-editor" hidden role="dialog" aria-modal="true" aria-labelledby="rsvp-editor-title">
          <form method="post" action="/dashboard/rsvp/" id="rsvp-editor-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="status" id="rsvp-editor-status" value="" />
            <p id="rsvp-editor-title" class="rsvp-editor-title">Change RSVP for <span id="rsvp-editor-name"></span></p>
            <div class="rsvp-editor-btns" role="group" aria-label="RSVP choice">
              <button type="button" class="btn btn-yes" data-rsvp-edit="yes" aria-pressed="false">Yes</button>
              <button type="button" class="btn btn-no" data-rsvp-edit="no" aria-pressed="false">No</button>
              <button type="button" class="btn btn-maybe" data-rsvp-edit="maybe" aria-pressed="false">Maybe</button>
            </div>
            <label class="field compact" style="margin-top:.6rem">Party size
              <input type="number" name="party_size" id="rsvp-editor-party" min="1" max="12" value="1" />
            </label>
            <div class="row-actions" style="margin-top:.7rem">
              <button type="submit" class="btn btn-primary btn-sm">Save</button>
              <button type="button" class="btn btn-secondary btn-sm" id="rsvp-editor-cancel">Cancel</button>
            </div>
          </form>
        </div>
      <% } %>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
