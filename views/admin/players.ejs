<%- include('../partials/header') %>
<section>
  <div class="card">
    <h2>Player admin</h2>
    <form id="player-form" method="post" action="<%= editing ? '/players/' + editing.id : '/players' %>" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="grid-2">
        <label class="field">Name
          <input type="text" name="name" required autocomplete="off" placeholder="Player name" value="<%= editing ? editing.name : '' %>" />
        </label>
        <label class="field">Email
          <input type="email" name="email" required autocomplete="off" placeholder="name@example.com" value="<%= editing ? editing.email : '' %>" />
        </label>
      </div>
      <div class="grid-2">
        <label class="field">Phone
          <input type="tel" name="phone" autocomplete="off" value="<%= editing && editing.phone ? editing.phone : '' %>" />
        </label>
        <label class="field">Active
          <select name="active">
            <option value="1" <%= !editing || editing.active ? 'selected' : '' %>>Active</option>
            <option value="0" <%= editing && !editing.active ? 'selected' : '' %>>Inactive</option>
          </select>
        </label>
      </div>
      <div class="row-actions">
        <button type="submit" class="btn btn-primary"><%= editing ? 'Save changes' : 'Add player' %></button>
        <% if (editing) { %>
          <a class="btn btn-secondary" href="/players">Cancel edit</a>
        <% } %>
      </div>
    </form>
    <% if (editing) { %>
      <div class="link-tools">
        <div class="row-actions">
          <button type="button" class="btn btn-quiet btn-sm" data-copy="<%= rsvpUrl(editing) %>" data-copy-label="Copy RSVP link">Copy RSVP link</button>
        </div>
        <form method="post" action="/players/<%= editing.id %>/rotate-token" onsubmit="return confirm('Create a new RSVP link? The current link will stop working.');" style="margin-top:.55rem">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-quiet btn-sm">Create a new RSVP link</button>
        </form>
      </div>
    <% } %>
    <div class="divider"></div>
    <div style="overflow-x:auto">
      <table>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Contact</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!players.length) { %>
            <tr><td colspan="3" class="empty">No players yet.</td></tr>
          <% } %>
          <% players.forEach(function (p) { %>
            <tr class="<%= p.active ? '' : 'inactive' %>">
              <td>
                <%= p.name %>
                <% if (!p.active) { %><span class="sample-tag">Inactive</span><% } %>
              </td>
              <td>
                <%= p.email %><br />
                <span class="muted"><%= p.phone || 'No phone' %></span>
              </td>
              <td>
                <div class="row-actions">
                  <a class="btn btn-secondary btn-sm" href="/players?edit=<%= p.id %>#player-form">Edit</a>
                  <% if (actor && actor.canDeletePlayers) { %>
                    <form method="post" action="/players/<%= p.id %>/delete" onsubmit="return confirm('Delete <%= p.name %>? Their RSVPs will be removed.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (actor && actor.canManageOrganizers) { %>
      <div class="divider"></div>
      <h3 id="temp-organizer" tabindex="-1">Temporary organizer</h3>
      <% if (pendingSetupLink) { %>
        <div class="setup-link-box" role="status">
          <p><strong>One-time setup link for <%= pendingSetupLink.playerName %></strong> (<%= formatNiceDate(pendingSetupLink.startsOn) %> through <%= formatNiceDate(pendingSetupLink.endsOn) %>)</p>
          <p class="copy-link"><%= pendingSetupLink.url %></p>
          <button type="button" class="btn btn-secondary btn-sm" data-copy="<%= pendingSetupLink.url %>" data-copy-label="Copy setup link">Copy setup link</button>
        </div>
      <% } %>
      <form method="post" action="/players/grant-organizer" id="grant-organizer-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="grid-2">
          <label class="field">Player
            <select name="grant_player_id" id="grant-player" required aria-label="Player to grant temporary organizer access">
              <option value="">Select a player</option>
              <% players.filter(function (p) { return p.active; }).forEach(function (p) { %>
                <option value="<%= p.id %>" <%= editing && String(editing.id) === String(p.id) ? 'selected' : '' %>><%= p.name %></option>
              <% }) %>
            </select>
          </label>
        </div>
        <div class="grid-2">
          <label class="field">Starts on
            <input type="date" name="starts_on" required value="<%= grantDefaults.starts_on %>" />
          </label>
          <label class="field">Ends on
            <input type="date" name="ends_on" required value="<%= grantDefaults.ends_on %>" />
          </label>
        </div>
        <div class="row-actions">
          <button type="submit" class="btn btn-primary">Grant temporary organizer access</button>
        </div>
      </form>
      <% if (grants && grants.length) { %>
        <h3>Organizer assignments</h3>
        <div style="overflow-x:auto">
          <table>
            <thead>
              <tr>
                <th scope="col">Player</th>
                <th scope="col">Dates</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% grants.forEach(function (g) { %>
                <tr>
                  <td><%= g.player_name %></td>
                  <td><%= formatNiceDate(g.starts_on) %> – <%= formatNiceDate(g.ends_on) %></td>
                  <td><%= g.status %></td>
                  <td>
                    <% if (g.status === 'active' || g.status === 'upcoming') { %>
                      <form method="post" action="/players/grants/<%= g.id %>/revoke" onsubmit="return confirm('Revoke temporary organizer access for <%= g.player_name %>?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-danger btn-sm">Revoke</button>
                      </form>
                    <% } else { %>—<% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
