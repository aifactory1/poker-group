<%- include('partials/header') %>
<section>
  <div class="card">
    <h2>RSVP</h2>
    <% if (typeof admin !== 'undefined' && admin) { %>
      <p class="row-actions" style="margin:.25rem 0 .75rem"><a class="btn btn-secondary" href="/">Back to dashboard</a></p>
    <% } %>
    <% if (player && player.name) { %>
      <p class="muted" style="margin:.25rem 0 .6rem">Hi <%= player.name %>.</p>
    <% } %>
    <% if (!game) { %>
      <p>There is no upcoming scheduled game right now.</p>
    <% } else { %>
      <div id="rsvp-game-line" class="muted">
        <p id="rsvp-game-date" style="margin:.25rem 0">Game: <%= formatNiceDate(game.game_date) %></p>
        <p id="rsvp-game-time" style="margin:.25rem 0">Time: <%= formatTime12(game.start_time) %>–<%= formatTime12(game.end_time) %></p>
        <% if (typeof venue !== 'undefined' && venue) { %>
          <p id="rsvp-game-venue" style="margin:.25rem 0">Venue: <%= venue %></p>
        <% } %>
      </div>
      <% if (game.status === 'cancelled') { %>
        <p>
          <span class="status-pill cancelled">Cancelled</span>
          <% if (game.skip_reason) { %><span> <%= game.skip_reason %></span><% } %>
        </p>
        <div class="row-actions">
          <a class="btn btn-secondary" href="/rsvp/<%= token %>/whos">Who's playing</a>
        </div>
      <% } else { %>
      <% var hasExtras = rsvp && ((rsvp.status === 'yes' && Number(rsvp.party_size) > 1) || (rsvp.message && String(rsvp.message).trim())); %>
      <form method="post" action="/rsvp/<%= token %>" id="rsvp-form" data-js-rsvp="1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="status" id="rsvp-status" value="<%= rsvp ? rsvp.status : '' %>" />
        <div class="rsvp-btns" role="group" aria-label="RSVP">
          <button type="submit" class="btn btn-yes" name="choice" value="yes" data-rsvp="yes" aria-pressed="<%= rsvp && rsvp.status === 'yes' ? 'true' : 'false' %>"><%= rsvp && rsvp.status === 'yes' ? '✓ Yes' : 'Yes' %></button>
          <button type="submit" class="btn btn-no" name="choice" value="no" data-rsvp="no" aria-pressed="<%= rsvp && rsvp.status === 'no' ? 'true' : 'false' %>"><%= rsvp && rsvp.status === 'no' ? '✓ No' : 'No' %></button>
          <button type="submit" class="btn btn-maybe" name="choice" value="maybe" data-rsvp="maybe" aria-pressed="<%= rsvp && rsvp.status === 'maybe' ? 'true' : 'false' %>"><%= rsvp && rsvp.status === 'maybe' ? '✓ Maybe' : 'Maybe' %></button>
        </div>
        <p class="rsvp-saved<%= typeof saved !== 'undefined' && saved ? ' show' : '' %>" id="rsvp-saved" role="status" aria-live="polite"><%= typeof saved !== 'undefined' && saved ? 'Saved' : '' %></p>
        <details class="rsvp-extras" id="rsvp-extras"<%= hasExtras ? ' open' : '' %>>
          <summary>Add a guest or message</summary>
          <div class="rsvp-extras-body">
            <label class="field" id="guest-field"<%= !rsvp || rsvp.status !== 'yes' ? ' hidden' : '' %>>Party size
              <input type="number" name="party_size" id="rsvp-guests" min="1" max="12" value="<%= rsvp && rsvp.party_size ? rsvp.party_size : 1 %>" />
            </label>
            <label class="field">Message
              <textarea name="message" id="rsvp-message" rows="3"><%= rsvp && rsvp.message ? rsvp.message : '' %></textarea>
            </label>
            <label class="field">Who can see this message?
              <select name="message_visibility" id="rsvp-visibility" aria-label="Message visibility">
                <option value="organizer" <%= !rsvp || rsvp.message_visibility !== 'group' ? 'selected' : '' %>>Only the organizer</option>
                <option value="group" <%= rsvp && rsvp.message_visibility === 'group' ? 'selected' : '' %>>Everyone in Poker Group</option>
              </select>
            </label>
            <div class="row-actions" id="extras-save-wrap">
              <button type="submit" class="btn btn-secondary btn-sm" id="extras-save">Save</button>
            </div>
          </div>
        </details>
        <div class="row-actions" style="margin-top:1rem">
          <a class="btn btn-secondary" href="/rsvp/<%= token %>/whos">Who's playing</a>
        </div>
      </form>
      <% } %>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
